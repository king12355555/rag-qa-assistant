# ============================================================
# 复制为 .env 后按需修改（本文件不会自动加载，仅作模板）
# cp .env.example .env
# ============================================================

# ---- LLM（OpenAI 兼容端点）----
# vLLM:    http://localhost:8000/v1
# Ollama:  http://localhost:11434/v1
# LM Studio: http://localhost:1234/v1
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen2.5-7b-instruct
LLM_TEMPERATURE=0.1

# ---- Embedding（本地加载）----
# 项目自带离线模型（offline/models/bge-small-zh-v1.5）时自动使用本地路径，无需联网；
# 可手动指定其他模型名或本地目录。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=auto        # auto / cpu / cuda

# ---- 向量库（Chroma 持久化）----
CHROMA_DIR=./data/chroma_db
COLLECTION_NAME=enterprise_rag

# ---- 检索与分割 ----
K=5                          # 检索返回块数
CHUNK_SIZE=512               # 块大小（字符）
CHUNK_OVERLAP=50             # 块重叠
NUM_MULTI_QUERIES=3          # MultiQuery 变体问题数

# ---- 数据 ----
DATA_DIR=./test_samples
